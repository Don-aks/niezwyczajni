include /components/video/video
include /components/cta-btn/cta-btn

-
  var videos = [
    {
      youtubeId: "dQw4w9WgXcQ",
      title: "Inspirujący film 1",
      duration: "3:33",
      label: "Motywacja",
    },
    {
      youtubeId: "3JZ_D3ELwOQ",
      title: "Inspirujący film 2",
      duration: "4:20",
      label: "Edukacja",
      isHD: false,
    },
    {
      youtubeId: "L_jWHffIx5E",
      title: "Inspirujący film 3",
      duration: "2:45",
      label: "Rozrywka",
    },
    {
      youtubeId: "eY52Zsg-KVI",
      title: "Inspirujący film 4",
      duration: "5:10",
      label: "Nauka",
      isHD: false,
    },
  ]

section.videos-preview.section
  .container.section__container
    header.section__header
      h2.section__title Zobacz nasze filmy
      h3.section__subtitle Inspirujące historie i przesłania

    .videos-preview__content.grid
      each video in videos
        +video({ ...video, width: 585, height: 329 })

    footer.section__footer.section__footer--centered
      +ctaBtn
      a.btn.btn--secondary.btn--with-icon.videos-preview__link(
        href="videos.html"
      )
        | Zobacz wszystkie filmy
        span.icon
          svg
            use(href="/__spritemap#video-circle")
