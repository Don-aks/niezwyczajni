mixin articleCard({ imageUrl, imageAlt, title, excerpt, link, date, dateText }, classNames = "", imageWidth = 370)
  article.article-card.articles-preview__card.flex.flex-col(class=classNames)
    .article-card__image-wrapper
      img.article-card__image.articles-preview__image(
        src=imageUrl
        alt=imageAlt
        width=imageWidth
        height="200"
      )
      time.article-card__date(datetime=date)= dateText
    .article-card__inner.flex.flex-col.gap-15
      h3.article-card__title.margin-reset= title
      p.article-card__text.margin-reset !{ excerpt }
      a.btn.btn--secondary.article-card__link(href=link)
