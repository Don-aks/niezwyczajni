mixin eventCard(props, imageWidth = 370, classNames = "")
  -
    var {
      imageSrc,
      imageAlt,
      title,
      date,
      dateText,
      location,
      locationUrl,
      description,
      link,
      isHappened,
    } = props;

  .event-card.flex.flex-col(class=`${isHappened ? 'happened ' : ''}${classNames}`)
    .event-card__image-wrapper
      img.event-card__image.sepia-50(
        src=imageSrc
        alt=imageAlt
        width=imageWidth
        height="200"
      )
      time.event-card__date(datetime=date)
        | #{ dateText }
    .event-card__inner.flex.flex-col.gap-15
      h3.event-card__title= title
      a.event-card__location.flex.gap-7(
        href=locationUrl
        target="_blank"
        rel="noopener noreferrer"
      )
        svg
          use(href="/__spritemap#location-pin")
        | #{ location }

      if description
        p.event-card__description.text
          | #{ description }
      if link
        a.event-card__link.btn.btn--secondary(href=link) Czytaj więcej
