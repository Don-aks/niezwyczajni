mixin contactBtn(props = {})
  -
    var {
      classNames = "",
      hasIcon = true,
      acf = {},
      isSecondary = true,
    } = props;

    var { key = "contact_button", map = "text:text,href:href" } = acf;

  button.btn(
    class=`${isSecondary ? "btn--secondary " : ""}${hasIcon ? "btn--with-icon" : ""}${classNames ? ` ${classNames}` : ""}`
    type="button"
    data-show-contact-info
    data-acf=key
    data-acf-map=map
  )
    | Skontaktuj się z nami

    if hasIcon
      span.icon
        svg
          use(href="/__spritemap#phone")
