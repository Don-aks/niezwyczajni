extends /layout

block head
  include /constants/constants
  title Zwyczajnie Niezwyczajni – Chrześcijańska Misja Ewangelizacyjna w Radomiu
  script(src="src/pages/index/index.js" type="module")

block content
  include /components/header/header
  +header("index")

  main.main
    section.about.section.relative.flex.justify-between
      .container.about__container
        .section__content.about__content
          h2.section__title.about__title O nas
          h3.section__subtitle.about__subtitle Kim Jesteśmy
          .about__text
            p
              | Chrześcijańska misja „Zwyczajnie niezwyczajni” z Radomia to
              | grupa ludzi, którzy doświadczyli Bożej łaski i miłości, a teraz
              | chcą przekazać ją dalej.
            p
              | Jako chrześcijanie, którzy zostali uwolnieni ze swych zniewoleń
              | i grzechów, przyjęliśmy do naszego życia nakaz misyjny Pana
              | Jezusa, który przed swoim odejściem powiedział do swoich
              | uczniów:

            figure
              blockquote
                | Idźcie na cały świat i głoście Ewangelię wszelkiemu stworzeniu!
              figcaption
                a(href="https://www.bible.com/pl/bible/3490/MRK.16.15")
                  | Ewangelia Marka 16,15

      img.about__image.absolute(
        src="https://misja.org.pl/wp-content/uploads/2018/07/wspolnota.jpg"
        alt="..."
        width="600"
        height="400"
      )

    section#meetings.section.meetings.bg-back(
      style="--image-url: url('https://campusministry.georgetown.edu/wp-content/uploads/sites/500/2024/02/53131181838_9beee9620b_k.jpg'); --brightness: 0.3"
    )
      .container
        h2.section__title.meetings__title Gdzie się spotykamy
        h3.section__subtitle.meetings__subtitle Nasze Spotkania
        .meetings__text
          p
            | Poza działaniami w więzieniach i na ulicach miasta, regularnie
            | spotykamy się w naszych placówkach, aby wspólnie modlić się,
            | studiować Pismo Święte oraz budować relacje wsparcia i
            | przyjaźni.

        ul.meetings__list.list-reset.flex.justify-center
          li.meeting.meetings__item.flex.flex-col
            img.meeting__image(
              src="https://www.luxmed.pl/assets/media/Grupa%20wsparcia.jpeg%3Ffm=webp&q=90&lossless=0"
              alt="Spotkanie grupy wsparcia i studium biblijne"
              width="400"
              height="267"
            )
            .meeting__inner.flex.flex-col
              svg.meeting__icon.transition-colors-svg
                use(href="src/assets/icons/mono/bible.svg")
              h4.meeting__title Grupa wsparcia & Studium Biblijne
              .meeting__text
                p
                  | Spotykamy się w każdą środę na Studium Biblijnym oraz grupie
                  | wsparcia w naszej placówce przy ul. 25 Czerwca 41, w
                  | godzinach
                  |
                  strong
                    time(datetime="16:00") 16:00
                    time(datetime="18:00") 18:00
              a.btn.btn--primary.meeting__btn(
                href="https://maps.app.goo.gl/ubpt2wxhCGNE9J2G8"
              )
                | Zobacz lokalizację

          //- TODO: Change img alt text
          li.meeting.meetings__item.flex.flex-col
            img.meeting__image(
              src="https://powiatzgorzelecki.pl/wp-content/uploads/2023/08/MK3_2941-scaled.jpg"
              alt="Spotkanie młodzieżowe TymekTeam w ..."
              width="400"
              height="267"
            )
            .meeting__inner.flex.flex-col
              svg.meeting__icon.transition-colors-svg
                use(href="src/assets/icons/mono/girl.svg")
              h4.meeting__title Spotkania młodzieżowe
              .meeting__text
                p
                  | W soboty prowadzimy spotkania młodzieżowe
                  |
                  a(href="https://instagram.com/tymekteam/")
                    | „TymekTeam”
                  |
                  | w „Domu Ojca” na ul. Głównej 12, w godzinach
                  |
                  strong
                    time(datetime="16:00") 16:00
                    time(datetime="19:00") 19:00
              a.btn.btn--primary.meeting__btn(
                href="https://maps.app.goo.gl/jDeH9SSvDxnCShxy9"
              )
                | Zobacz lokalizację
