include /constants/constants

mixin header(currentPage)
  header.header.z-1
    .header__container.container.flex.justify-between.items-center
      img.logo(
        src="src/assets/images/logo.webp"
        alt="Logotypa z sylwetką osoby stojącej tyłem, z szeroko rozłożonymi ramionami, na tle wschodzącego słońca"
        width="83"
        height="55"
      )
      nav.header__nav.nav
        ul.nav__list.flex.items-center.list-reset
          each [page, label] of Object.entries(PAGES)
            li.nav__item(class=currentPage === page ? "relative" : "")
              if currentPage === page
                svg.nav__cross.absolute.transition-colors-svg
                  use(href="/__spritemap#cross")
              a.nav__link(
                class=currentPage === page ? "current" : ""
                href=page + ".html"
              )= label

  if currentPage === "index"
    include /components/banner/banner
