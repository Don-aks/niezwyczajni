mixin card(props, classNames = "", imageWidth = 370)
  -
    var {
      imageSrc,
      imageAlt,
      iconId,
      title,
      text,
      href,
      isOpenInNewTab,
      btnText,
      btnIcon,
      isCardClickable,
    } = props;

  if typeof isOpenInNewTab === "undefined"
    - isOpenInNewTab = true;

  li.card(class=`${classNames} ${isCardClickable ? 'clickable' : ''}`)
    article.card__wrapper
      if imageSrc
        img.card__image(
          src=imageSrc
          alt=imageAlt
          width=imageWidth
          height="267"
        )
      .card__inner
        if iconId
          svg.card__icon.transition-colors-svg
            use(href=`/__spritemap#${iconId}`)
        h4.card__title= title
        if text
          .card__text
            p !{ text }
        if btnText
          - var Tag = href ? "a" : "button";

          #{Tag}.btn.btn--primary.card__btn(
            type=!href ? "button" : null
            href=href
            target=isOpenInNewTab && "_blank"
            rel=isOpenInNewTab && "noopener noreferrer"
          )
            | #{ btnText }
            if btnIcon
              svg
                use(href=`/__spritemap#${btnIcon}`)
