section.videos-preview.section
  .container.section__container.items-start
    header.section__header
      h2.section__title Zobacz nasze filmy
      h3.section__subtitle Inspirujące historie i przesłania

    .section__cards-container
      each video in videos
        +video({ ...video, width: 370, height: 208 }, "section__card")

    a.btn.btn--primary.btn--with-icon.videos-preview__link(
      href="videos.html"
      style="--icon: url('/__spritemap#video_white-view')"
    )
      span Zobacz wszystkie filmy
