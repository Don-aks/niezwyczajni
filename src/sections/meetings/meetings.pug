section#meetings.meetings.section.section--on-dark.section--centered.section--extended.bg-back(
  style="--image-url: url('https://campusministry.georgetown.edu/wp-content/uploads/sites/500/2024/02/53131181838_9beee9620b_k.jpg'); --brightness: 0.35"
)
  .container.section__container
    header.section__header
      h2.section__title
        | Gdzie można nas znaleźć
      h3.section__subtitle Nasze Spotkania
      .section__text
        p
          | Poza działaniami w więzieniach i na ulicach miasta, regularnie
          | spotykamy się w naszych placówkach, aby wspólnie modlić się,
          | studiować Pismo Święte oraz budować relacje wsparcia i
          | przyjaźni.

    ul.section__cards-container.meetings__list.list-reset
      each meeting of meetings
        +card(meeting)

    footer.section__footer.meetings__footer
      +ctaBtn
      a.btn.btn--secondary.btn--with-icon.meetings__link(href="#faq")
        | Najczęściej zadawane pytania
        span.icon
          svg
            use(href="/__spritemap#question")
