mixin imageWrapper(props, classNames = "", flags = {})
  - var { src, alt, caption, width = 600, height = 400 } = props;
  - var { isAnimated = true, isFocusable = true } = flags;

  figure.image-wrapper(
    class=classNames
    tabindex=isFocusable && "0"
    data-animate-on-scroll=isAnimated
    data-animation-class=isAnimated && "shown"
  )
    img.image-wrapper__image(src=src alt=alt width=width height=height)
    if caption
      figcaption.image-wrapper__caption= caption
