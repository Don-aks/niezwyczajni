include /components/cards/event-card/event-card
include /components/buttons/cta-btn
include ./events-preview-events

section.section.events-preview.relative
  svg.events-preview__decor(data-animate-on-scroll)
    use(href="/__spritemap#cross")
  .container.section__container.events-preview__container
    header.section__header.events-preview__header
      h2.section__title Wydarzenia i aktualności
      h3.section__subtitle Bądź na bieżąco z naszymi inicjatywami

    .events-preview__content.section__cards-container
      each event in events
        +eventCard({ ...event, imageWidth: 370 }, "events-preview__card section__card")

    footer.section__footer.section__footer--centered.events-preview__footer
      +ctaBtn
      a.btn.btn--secondary.btn--with-icon(href="events.html")
        | Zobacz wszystkie wydarzenia
        span.icon
          svg
            use(href="/__spritemap#event")
