extends /layout

block head
  include /constants/constants
  title Zwyczajnie Niezwyczajni – Chrześcijańska Misja Ewangelizacyjna w Radomiu
  script(src="src/pages/index/index.js" type="module")

block content
  include /components/header/header
  +header("index")

  main.main
    section.about.section.relative.flex.justify-between
      .container.about__container
        .section__content.about__content
          h2.section__title.about__title O nas
          h3.section__subtitle.about__subtitle Kim Jesteśmy
          .about__text
            p
              | Chrześcijańska misja „Zwyczajnie niezwyczajni” z Radomia to
              | grupa ludzi, którzy doświadczyli Bożej łaski i miłości, a teraz
              | chcą przekazać ją dalej.
            p
              | Jako chrześcijanie, którzy zostali uwolnieni ze swych zniewoleń
              | i grzechów, przyjęliśmy do naszego życia nakaz misyjny Pana
              | Jezusa, który przed swoim odejściem powiedział do swoich
              | uczniów:

            figure
              blockquote
                | Idźcie na cały świat i głoście Ewangelię wszelkiemu stworzeniu!
              figcaption
                a(href="https://www.bible.com/pl/bible/3490/MRK.16.15")
                  | Ewangelia Marka 16,15

      img.about__image.absolute(
        src="https://misja.org.pl/wp-content/uploads/2018/07/wspolnota.jpg"
        alt="..."
        width="600"
        height="400"
      )
