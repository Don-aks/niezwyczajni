include /components/image-wrapper/image-wrapper
include /components/buttons/cta-btn
include /components/buttons/contact-btn
include ./about-mission-items

section#about-mission.about-mission.section
  .container.section__container
    header.section__header
      h2.section__title
        | Blisko ludzi. Blisko ich bólu i nadziei
      h3.section__subtitle
        | Boża łaska ma moc przemienić życie <strong>każdego</strong> człowieka
      .section__text.text(data-acf="about_mission_text" data-acf-html)
        p
          | Dlatego odwiedzamy więzienia, szkoły oraz miejsca, w których żyją
          | ludzie pozbawieni nadziei, dzieląc się z nimi Ewangelią i osobistym
          | świadectwem.

    .about-mission__content.relative
      .about-mission__slider-navigation.slider__navigation
        button.slider__btn.slider__btn--prev
          svg.slider__btn-icon
            use(href="/__spritemap#arrow-right")
          span.visually-hidden Poprzedni słajd

        button.slider__btn.slider__btn--next
          svg.slider__btn-icon
            use(href="/__spritemap#arrow-right")
          span.visually-hidden Następny słajd

      .about-mission__slider.slider.swiper(
        data-animate-on-scroll
        data-animate-once
        data-animate-duration="500"
        data-animate-ignore-focus
      )
        ul.about-mission__slider-inner.swiper-wrapper.text-center.list-reset
          each item of aboutMissionItems
            li.about-mission__item.swiper-slide.flex-col.gap-15
              .about-mission__slides.swiper
                ul.about-mission__slides-inner.swiper-wrapper.list-reset
                  each img in item.images
                    li.about-mission__slide.swiper-slide
                      +imageWrapper({ ...img, width: 200, height: 200, isSwiperSlide: true })

              .about-mission__item-content
                .about-mission__item-info.flex.flex-col.gap-15
                  h4.about-mission__item-title= item.title
                  p.about-mission__item-text !{ item.text }
                  span.about-mission__item-note= item.note

    footer.section__footer.section__footer--centered
      +ctaBtn
      +contactBtn
