mixin imageWrapper({ src, alt, width, height, caption }, classNames = "")
  if !width || !height
    - width = 600;
    - height = 400;

  if !alt
    - alt = caption ?? "";

  figure.image-wrapper.slider__slide(class=classNames)
    img.image-wrapper__image(src=src alt=alt width=width height=height)
    if caption
      figcaption.image-wrapper__caption= caption
