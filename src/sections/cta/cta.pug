include /components/buttons/cta-btn
include /components/buttons/contact-btn

section.cta.section
  .container.flex.justify-between.items-center
    .cta__content
      header.cta__header.section__header
        h2.section__title Dołącz do nas
        h3.section__subtitle Chcesz być częścią tej misji?
        .section__text
          p
            | Spotykamy się regularnie, modlimy się,
            | rozmawiamy i pomagamy sobie nawzajem.

      .section__footer
        +ctaBtn("cta__link")
        +contactBtn({ classNames: "cta__btn", hasIcon: false })

    img.cta__image(
      src="https://as1.ftcdn.net/jpg/02/11/29/06/1000_F_211290641_8wvpbJKta9wIs1jcnwQXjF1dXehA1QM0.jpg"
      alt="..."
      width="550"
      height="400"
    )
