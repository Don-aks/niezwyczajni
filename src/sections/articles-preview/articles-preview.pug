include /components/buttons/cta-btn
include /components/cards/article-card/article-card
include ./articles-preview-articles

section.articles-preview.section.relative
  svg.articles-preview__decor(data-animate-on-scroll)
    use(href="/__spritemap#cross")
  .container.section__container.articles-preview__container
    header.section__header
      h2.section__title Nasz blog
      h3.section__subtitle Najnowsze artykuły z życia misji
    .articles-preview__content.section__cards-container
      each article of articles
        +articleCard(article, "section__card")
    footer.section__footer.section__footer--centered
      +ctaBtn
      a.btn.btn--secondary.btn--with-icon(href="blog.html")
        | Zobacz wszystkie artykuły
        span.icon
          svg
            use(href="/__spritemap#article")
