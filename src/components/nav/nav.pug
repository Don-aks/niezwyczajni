include /constants/constants

mixin nav(currentPage)
  nav.header__nav.nav
    ul.nav__list.list-reset.flex.items-center.gap-30
      each [page, navItem] of Object.entries(PAGES)
        li.nav__item(class=currentPage === page ? "relative" : "")
          if currentPage === page && typeof navItem === "string"
            svg.nav__marker.absolute.transition-colors
              use(href="/__spritemap#cross")

          if typeof navItem === "string"
            a.nav__link(
              class=currentPage === page ? "current" : ""
              href=page + ".html"
              tabindex=currentPage === page ? "-1" : null
            )= navItem

          else
            .nav__submenu-wrapper.relative
              button.nav__link.nav__submenu-toggle(type="button")= navItem.name

              ul.nav__submenu.list-reset
                each [subpage, sublabel] of Object.entries(navItem.subpages)
                  li.nav__submenu-item(
                    class=currentPage === subpage ? "relative" : ""
                  )
                    a.nav__link.nav__submenu-link(
                      class=currentPage === subpage ? "current" : ""
                      href=subpage + ".html"
                    )= sublabel

                    if currentPage === subpage
                      svg.nav__marker.absolute.transition-colors
                        use(href="/__spritemap#cross")
