mixin card(props, classNames = "", options = {})
  -
    var {
      imageSrc,
      imageAlt,
      iconId,
      title,
      text,
      href,
      isOpenInNewTab = true,
      btnText,
      btnIcon,
    } = props;

    var {
      isListItem = true,
      hasAnimation = true,
      isResponsive = true,
      isCardClickable = false,
    } = options;

  - var Tag = isListItem ? "li" : "div";

  #{Tag}.card(
    class=[classNames, isCardClickable && "clickable", isResponsive && "responsive"]
    data-animate-on-scroll=hasAnimation
  )
    article.card__wrapper
      if imageSrc
        img.card__image(src=imageSrc alt=imageAlt width="370" height="267")
      .card__inner
        if iconId
          span.card__icon.transition-colors
            svg
              use(href=`/__spritemap#${iconId}`)
        h4.card__title= title
        if text
          .card__text.text(data-acf="" data-acf-html)
            | !{ text }
        if btnText
          - var Tag = href ? "a" : "button";

          #{Tag}.btn.btn--primary.card__btn(
            type=!href ? "button" : null
            href=href
            target=isOpenInNewTab && "_blank"
            rel=isOpenInNewTab && "noopener noreferrer"
          )
            | #{ btnText }
            if btnIcon
              span.icon
                svg
                  use(href=`/__spritemap#${btnIcon}`)
