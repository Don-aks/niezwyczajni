section.banner.relative.bg-back(
  style="--image-url: url('https://res.cloudinary.com/aenetworks/image/upload/c_fill,ar_2,w_3840,h_1920,g_auto/dpr_auto/f_auto/q_auto:eco/v1/christianity-gettyimages-121153575?_a=BAVAZGID0'); --brightness: 0.5; --position: center"
)
  .container.banner__container
    .banner__content.relative
      svg.banner__cross.absolute.z-1
        use(href="/__spritemap#cross")
      h1.banner__title
        | Zwyczajnie Niezwyczajni – Chrześcijańska Misja Niosąca Nadzieję w Radomiu
      .banner__lead
        p
          | Głosimy Ewangelię Jezusa Chrystusa, dzielimy się świadectwem
          | przemienionego życia i docieramy do ludzi tam, gdzie
          | najbardziej potrzebują nadziei.

      .banner__buttons.flex
        a.btn.btn--primary.banner__btn.banner__btn--primary(href="#meetings")
          | Przyjdź na spotkanie
      span.banner__note
        span Otwarte dla każdego
        span Bez zobowiązań
