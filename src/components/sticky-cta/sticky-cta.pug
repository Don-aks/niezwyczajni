.sticky-cta
  button.sticky-cta__link.inline-grid.place-items-center(
    type="button"
    title="Wyświetl dane kontaktowe"
  )
    span.sticky-cta__description.visually-hidden Wyświetl dane kontaktowe
    svg.sticky-cta__icon.transition-colors
      use(href="/__spritemap#phone")

  .sticky-cta__popover
    include /components/contact-info/contact-info
