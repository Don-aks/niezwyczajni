include /components/buttons/cta-btn
include /components/buttons/contact-btn
include /components/cards/card/card
include ./about-banner-cards

section.about-banner.section
  .about-banner__container.container.flex.flex-col
    .about-banner__hero.flex.justify-between.items-center.gap-30
      .about-banner__content.section__content.flex.flex-col.gap-30
        h1.about-banner__title
          | Chrześcijańska misja „Zwyczajnie niezwyczajni”
        .about-banner__text.text
          p
            | Wierzymy, że nikt nie jest stracony.
          p
            | Że każdy człowiek — bez względu na swoją historię, błędy czy
            | upadki — może doświadczyć miłości Boga, która naprawdę zmienia
            | życie.
        .about-banner__buttons.flex.gap-15
          +ctaBtn
          +contactBtn({ hasIcon: false })

      .about-banner__image-wrapper.relative
        img.about-banner__image.absolute(
          src="https://misja.org.pl/wp-content/uploads/2018/07/wspolnota.jpg"
          alt="..."
          width="600"
          height="400"
        )
        img.about-banner__image.absolute(
          src="https://zarzadcy.com.pl/wp-uploads/wspolnota-mieszkaniowa-nmxe.jpg"
          alt="..."
          width="600"
          height="400"
        )
        img.about-banner__image.absolute(
          src="https://www.poslanie.pl/upload/art_paragraph/591_img1_people-4050698_1280.jpg"
          alt="..."
          width="600"
          height="400"
        )

    ul.section__cards-container.about-banner__cards-container.list-reset.relative.js-animation-card-container
      each card in cards
        +card({ ...card, isClickable: true }, "about-banner__card section__card")
