section.about-mission.section.section--on-dark.section--centered.bg-back(
  style="--image-url: url('https://www.custodia.org/wp-content/uploads/2024/11/whatsapp_image_2022-07-01_at_17.41.43.jpeg'); --brightness: 0.35"
)
  .container
    h2.section__title Wierzymy w moc przemienienia
    h3.section__subtitle Ewangelizacja Uliczna i Więzienna
    .section__text
      p
        | Boża łaska ma moc przemienić życie <strong>każdego</strong>
        | człowieka. Dlatego odwiedzamy więzienia, szkoły oraz miejsca,
        | w których żyją ludzie pozbawieni nadziei, dzieląc się z nimi
        | Ewangelią i osobistym świadectwem.

    ul.section__cards-container.list-reset
      li.card.flex.flex-col.m-3
        img.card__image(
          src="https://sojo.net/files/blog/shutterstock_1126048436_1.jpg"
          alt="Ewangelizacja uliczna w Radomiu"
          width="400"
          height="267"
        )
        .card__inner.flex.flex-col
          svg.card__icon.transition-colors-svg
            use(href="/__spritemap#city")
          h4.card__title Działamy na ulicach Radomia
          .card__text
            p
              | Regularnie wychodzimy na ulice Radomia, aby dzielić się
              | Dobrą Nowiną z tymi, którzy jej najbardziej potrzebują.

      li.card.flex.flex-col.m-3
        img.card__image(
          src="https://www.christianitytoday.com/wp-content/uploads/2022/08/130651.jpeg?w=1920"
          alt="Ewangelizacja więzienna w Radomiu"
          width="400"
          height="267"
        )
        .card__inner.flex.flex-col
          svg.card__icon.transition-colors-svg
            use(href="/__spritemap#prison")
          h4.card__title Działamy we więzieniach
          .card__text
            p
              | Odwiedzamy osadzone osoby w radomskich zakładach
              | karnych, oferując im wsparcie duchowe i nadzieję na
              | przemianę poprzez Ewangelię.
