mixin imageWrapper(props, classNames = "")
  -
    var {
      src,
      alt,
      caption,
      width = 600,
      height = 400,
      isAnimated = true,
      isSwiperSlide = false,
      isFocusable = Boolean(props.caption),
    } = props;

    isAnimated = Boolean(isAnimated && caption && !isSwiperSlide);

  figure.image-wrapper(
    class=classNames
    tabindex=isFocusable && "0"
    data-animate-on-scroll=isAnimated
    data-animate-once=isAnimated
    data-animate-duration=isAnimated && "500"
  )
    img.image-wrapper__image(src=src alt=alt width=width height=height)
    if caption
      figcaption.image-wrapper__caption= caption
