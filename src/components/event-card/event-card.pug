mixin eventCard({ imageSrc, imageAlt, title, date, dateText, location, description, link, isHappened }, imageWidth = 370, classNames = "")
  .event-card.flex.flex-col(class=`${isHappened ? 'happened ' : ''}${classNames}`)
    .event-card__image-wrapper
      img.event-card__image(
        src=imageSrc
        alt=imageAlt
        width=imageWidth
        height="200"
      )
      time.event-card__date(datetime=date)
        | #{ dateText }
    .event-card__inner.flex.flex-col
      h3.event-card__title= title
      if description
        p.event-card__description !{ description }
      if link
        a.event-card__link.btn.btn--secondary(href=link) Czytaj więcej
