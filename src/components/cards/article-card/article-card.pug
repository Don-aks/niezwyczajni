mixin articleCard(props, classNames = "")
  -
    var {
      imageUrl,
      imageAlt,
      date,
      dateText,
      title,
      excerpt,
      link,
      imageWidth = 370,
    } = props;

  article.article-card.articles-preview__card.flex.flex-col(class=classNames)
    .article-card__image-wrapper
      img.article-card__image.articles-preview__image.sepia-50(
        src=imageUrl
        alt=imageAlt
        width=imageWidth
        height="200"
      )
      time.article-card__date(datetime=date)= dateText
    .article-card__inner.flex.flex-col.gap-15
      h3.article-card__title= title
      .article-card__text.text !{ excerpt }
      a.btn.btn--secondary.article-card__link(href=link)
