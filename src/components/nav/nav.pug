include /constants/constants

mixin _navSubmenu(subpages, currentPage)
  ul.nav__submenu.list-reset
    each [subpage, sublabel] of Object.entries(subpages)
      - var isCurrent = currentPage === subpage;

      li.nav__submenu-item(class=isCurrent && "relative")
        a.nav__link.nav__submenu-link(
          class=isCurrent && "current"
          href=subpage + ".html"
        )= sublabel

        if isCurrent
          svg.nav__marker.absolute.transition-colors
            use(href="/__spritemap#cross")

mixin _navList(currentPage)
  ul.nav__list.list-reset.flex.items-center.gap-30
    each [page, navItem] of Object.entries(PAGES)
      -
        var isCurrent = currentPage === page;
        var pageHref = page + ".html";

      li.nav__item(class=isCurrent && "relative")
        if isCurrent
          svg.nav__marker.absolute.transition-colors
            use(href="/__spritemap#cross")

        if typeof navItem === "string"
          a.nav__link(
            class=isCurrent && "current"
            href=pageHref
            tabindex=isCurrent && "-1"
          )= navItem

        else
          .nav__submenu-wrapper.relative
            button.nav__link.nav__submenu-toggle(type="button")= navItem.name
            +_navSubmenu(navItem.subpages, currentPage)

mixin nav(currentPage, props = {})
  -
    var {
      classNames = "header__nav",
      isTop = true
    } = props;

  nav.nav(class=[classNames, isTop && "nav--top"])
    +_navList(currentPage)

    button.nav__btn.grid.place-items-center(type="button")
      span.visually-hidden Otwórz menu
      span.nav__btn-bar

    if isTop
      dialog#menu.nav__menu
        .nav__menu-buttons.relative
          button.nav__btn.nav__btn--active.nav__menu-btn.absolute.grid.place-items-center(
            type="button"
          )
            span.visually-hidden Zamknij menu
            span.nav__btn-bar

          button.nav__back.absolute.grid.place-items-center(type="button")
            span.visually-hidden Wróć do poprzedniego menu
            svg.nav__back-icon
              use(href="/__spritemap#arrow-back")

        +_navList(currentPage)
