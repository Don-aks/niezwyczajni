include /components/image-wrapper/image-wrapper

-
  var gallery = [
    {
      src: "https://campusministry.georgetown.edu/wp-content/uploads/sites/500/2024/02/53131181838_9beee9620b_k.jpg",
      caption: "Ewangelizacja uliczna"
    },
    {
      src: "https://www.luxmed.pl/assets/media/Grupa%20wsparcia.jpeg%3Ffm=webp&q=90&lossless=0",
      caption: "Warsztaty ewangelizacyjne"
    },
    {
      src: "https://powiatzgorzelecki.pl/wp-content/uploads/2023/08/MK3_2941-scaled.jpg",
      caption: "Spotkanie ewangelizacyjne"
    }
  ]

section.gallery-preview.section.section--centered
  .container
    header.section__header.gallery-preview__header
      h2.section__title.section__title--border-top Zobacz nasze zdjęcia
      h3.section__subtitle Nasza galeria
    .gallery-preview__content.relative
      .slider.gallery-preview__slider.swiper
        .slider__wrapper.swiper-wrapper
          each image of gallery
            +imageWrapper(image, "swiper-slide")

      .slider__navigation.gallery-preview__slider-navigation
        button.slider__btn.slider__btn--prev
          svg.slider__btn-icon
            use(href="__spritemap#arrow-right")
          span.visually-hidden Poprzednie zdjęcie
        button.slider__btn.slider__btn--next
          svg.slider__btn-icon
            use(href="__spritemap#arrow-right")
          span.visually-hidden Następne zdjęcie

    a.btn.btn--primary.gallery-preview__link(href="gallery.html")
      span.gallery-preview__link-text Zobacz całą galerię
