include /components/buttons/cta-btn

section.banner.relative.bg-back(
  style={
    "--image-url": "url('https://res.cloudinary.com/aenetworks/image/upload/c_fill,ar_2,w_3840,h_1920,g_auto/dpr_auto/f_auto/q_auto:eco/v1/christianity-gettyimages-121153575?_a=BAVAZGID0')",
    "--brightness": 0.5,
    "--position": "center",
  }
)
  .container.banner__container.relative
    svg.banner__cross.absolute(viewBox="9 0 41 140")
      path(d="M40,1H60V40H90V60H60V139H40V60H10V40H40Z")
    .banner__content
      h1.banner__title
        | Zwyczajnie Niezwyczajni – Chrześcijańska Misja Niosąca Nadzieję
        | w Radomiu
      .banner__lead
        p
          | Głosimy Ewangelię Jezusa Chrystusa i dzielimy się świadectwem
          | przemienionego życia.

      .banner__buttons.flex
        +ctaBtn("banner__btn banner__btn--primary")
        a.banner__btn.banner__btn--secondary(href="about.html")
          | Dowiedź się więcej o nas
      p.banner__note
        | Otwarte dla każdego • Bez zobowiązań
