include /components/image-wrapper/image-wrapper

-
  var images = [
    {
      src: "https://iccscampus.org/wp-content/uploads/2017/11/Serving-God-in-prison.jpg",
      caption: "Ewangelizacja w więzieniu"
    },
    {
      src: "https://wp.cruxnow.com/wp-content/uploads/2021/06/street-evangelization.png",
      caption: "Ewangelizacja uliczna"
    },
    {
      src: "https://www.evangelism.today/wp-content/uploads/2023/03/preaching_1-1080x675.jpg",
      caption: "Praca z młodzieżą"
    }
  ]

section.mission.section
  .container.mission__container.flex.justify-between.items-center.gap-30
    .slider.mission__slider.swiper
      ul.slider__wrapper.swiper-wrapper.list-reset
        each image of images
          li.slider__slide.swiper-slide
            +imageWrapper(image, "slider__image-wrapper")

    .mission__content.section__content
      h2.section__title.mission__title Jaki nasz cel?
      h3.section__subtitle.mission__subtitle Nasza Misja
      .mission__text
        p
          | Naszym głównym zadaniem jest głoszenie Dobrej Nowiny oraz
          | niesienie nadziei wszystkim tym, którzy ją utracili. Wierzymy,
          | że Pan Jezus kocha każdego człowieka i pragnie, aby każdy
          | został uwolniony z mocy grzechu, nałogów oraz wszelkich
          | zniewoleń, które niszczą jego życie.

        figure
          blockquote
            | Tak bowiem Bóg umiłował świat, że Syna swego Jednorodzonego
            | dał, aby każdy, kto w Niego wierzy, nie zginął, ale miał
            | życie wieczne. Albowiem Bóg nie posłał swego Syna na świat
            | po to, aby świat potępił, lecz po to, aby świat został przez
            | Niego zbawiony.
          figcaption
            a(href="https://www.bible.com/pl/bible/3490/JHN.3.16-17")
              | Ewangelia Jana 3,16–17
      .slider-pagination.mission__slider-pagination.flex
