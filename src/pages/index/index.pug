extends /layout

block head
  include /constants/constants
  - var pageName = "index";
  title Zwyczajnie Niezwyczajni – Chrześcijańska Misja Ewangelizacyjna w Radomiu
  script(src=`src/pages/${pageName}/${pageName}.js` type="module")

block content
  include /components/header/header
  +header(pageName)

  main.main
    include /sections/banner/banner
    include /sections/about/about
    include /sections/events-preview/events-preview
    include /sections/faq/faq
    +faq(pageName)
    include /sections/videos-preview/videos-preview
    include /sections/meetings/meetings
    include /sections/cta/cta
