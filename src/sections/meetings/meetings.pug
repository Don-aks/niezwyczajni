include /components/cards/card/card
include /components/buttons/contact-btn
include ./meetings-list

section#meetings.meetings.section.section--on-dark.section--centered.section--extended.bg-back(
  style={
    "--image-url": "url('https://campusministry.georgetown.edu/wp-content/uploads/sites/500/2024/02/53131181838_9beee9620b_k.jpg')",
    "--brightness": 0.35,
  }
)
  .container.section__container
    header.section__header
      h2.section__title
        | Gdzie można nas znaleźć
      h3.section__subtitle Nasze Spotkania
      .section__text.text
        p
          | Regularnie spotykamy się w naszych placówkach, by modlić się,
          | studiować Pismo Święte i budować relacje wsparcia.

    ul.section__cards-container.meetings__list.list-reset.js-animation-card-container
      each meeting of meetings
        +card(meeting, "section__card")

    footer.section__footer.section__footer--centered.meetings__footer
      +contactBtn({ classNames: "btn--primary", hasIcon: false, isSecondary: false })
      a.btn.btn--secondary.btn--with-icon.btn--white(href="#faq")
        | Najczęściej zadawane pytania
        span.icon
          svg
            use(href="/__spritemap#question")
