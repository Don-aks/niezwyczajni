include /constants/constants

mixin nav(currentPage)
  nav.header__nav.nav
    ul.nav__list.list-reset.flex.items-center.gap-30
      each [page, label] of Object.entries(PAGES)
        li.nav__item(class=currentPage === page ? "relative" : "")
          if currentPage === page
            svg.nav__cross.absolute.transition-colors-svg
              use(href="/__spritemap#cross")
          a.nav__link(
            class=currentPage === page ? "current" : ""
            href=page + ".html"
            tabindex=currentPage === page ? "-1" : "0"
          )= label
