include /components/buttons/cta-btn

section.about.section
  .container.about__container.flex.justify-between.gap-30
    .about__content.section__container
      header.section__header.about__header
        h2.section__title.about__title Kim Jesteśmy
        h3.section__subtitle.about__subtitle O naszej misji
      .about__text.text
        p
          | Chrześcijańska misja „Zwyczajnie niezwyczajni” z Radomia to
          | grupa ludzi, którzy doświadczyli Bożej łaski i miłości, a teraz
          | chcą przekazać ją dalej.
        strong
          | Nie jesteśmy ruchem — jesteśmy wspólnotą.
        p
          | Spotykamy się regularnie, modlimy się, studiujemy Pismo
          | Święte i angażujemy się w różne formy ewangelizacji.

      footer.section__footer
        +ctaBtn
        a.btn.btn--secondary(href="about.html")
          | Dowiedz się więcej o nas

    .about__image-wrapper
      .about__image-container
        .about__image-inner.relative(data-animate-on-scroll)
          img.about__image.absolute(
            src="https://misja.org.pl/wp-content/uploads/2018/07/wspolnota.jpg"
            alt="..."
            width="600"
            height="400"
            data-animate-item
          )
          img.about__image.absolute(
            src="https://zarzadcy.com.pl/wp-uploads/wspolnota-mieszkaniowa-nmxe.jpg"
            alt="..."
            width="600"
            height="400"
            data-animate-item
          )
          img.about__image.absolute(
            src="https://www.poslanie.pl/upload/art_paragraph/591_img1_people-4050698_1280.jpg"
            alt="..."
            width="600"
            height="400"
            data-animate-item
          )
