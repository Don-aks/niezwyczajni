include /components/video/video
include /components/buttons/cta-btn
include ./videos-preview-videos

section.videos-preview.section
  .container.section__container
    header.section__header
      h2.section__title Zobacz nasze filmy
      h3.section__subtitle Inspirujące historie i przesłania

    .videos-preview__content.grid
      each video in videos
        +video({ ...video, width: 585, height: 329, hasAnimation: true })

    footer.section__footer.section__footer--centered
      +ctaBtn
      a.btn.btn--secondary.btn--with-icon.videos-preview__link(
        href="videos.html"
      )
        | Zobacz wszystkie filmy
        span.icon
          svg
            use(href="/__spritemap#video-circle")
