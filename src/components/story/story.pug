mixin _story({ iconId, title, text })
  li.story__item.transition-colors
    .story__icon-wrapper.transition-colors
      svg.story__icon.transition-colors-svg
        use(href=`__spritemap#${iconId}`)
    h4.story__item-title.transition-colors= title
    p.story__item-text.transition-colors= text

mixin storiesList(storiesArray, classNames = "")
  ul.story.list-reset(class=classNames)
    each item of storiesArray
      +_story(item)
